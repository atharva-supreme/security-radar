# Copied to .env by server/install.sh. Keep .env at mode 600; it is git-ignored.

# GitHub token that can read every repository in the organisation (classic, scope: repo).
# Used for the lockfiles AND for advisory calls (5,000 requests/hour per user).
REPO_READ_TOKEN=
GITHUB_TOKEN=${REPO_READ_TOKEN}

# Slack incoming webhook for the channel that receives the daily messages.
SLACK_WEBHOOK_URL=

# MySQL for history (optional; leave empty to skip). mysql://user:password@localhost:3306/security_radar
MYSQL_URL=

# Parallel requests per source during the scan.
SCAN_CONCURRENCY=6
TZ=Asia/Kolkata
